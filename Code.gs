  if(id){try{ss=SpreadsheetApp.openById(id)}catch(e){id=''}}
  if(!ss){const files=DriveApp.getFilesByName(DB_NAME);while(files.hasNext()){const f=files.next();if(f.getMimeType()===MimeType.GOOGLE_SHEETS){const candidate=SpreadsheetApp.openById(f.getId());if(candidate.getSheets().some(s=>Object.keys(HEADERS).includes(s.getName()))){ss=candidate;break}}}if(!ss)ss=SpreadsheetApp.create(DB_NAME)}
  props.setProperty('SPREADSHEET_ID',ss.getId());
  Object.entries(HEADERS).forEach(([name,headers])=>ensureSheet_(ss,name,headers));
  upsertSeed_(ss);formatDatabase_(ss);return ss.getUrl();
}
function ensureSheet_(ss,name,headers){let sh=ss.getSheetByName(name)||ss.insertSheet(name);if(sh.getLastRow()===0)sh.getRange(1,1,1,headers.length).setValues([headers]);else{const current=sh.getRange(1,1,1,headers.length).getValues()[0];if(current.join('|')!==headers.join('|'))throw Error('Struktur helaian '+name+' tidak sepadan. Semak sebelum meneruskan.')}return sh}
function upsertSeed_(ss){const ps=ss.getSheetByName(SHEETS.PORTFOLIOS),ts=ss.getSheetByName(SHEETS.TASKS);const pids=new Set(ps.getLastRow()>1?ps.getRange(2,1,ps.getLastRow()-1,1).getValues().flat().map(String):[]);const tids=new Set(ts.getLastRow()>1?ts.getRange(2,1,ts.getLastRow()-1,1).getValues().flat().map(String):[]);const newP=SEED_DATA.portfolios.filter(p=>!pids.has(p.portfolio_id)).map(p=>[p.portfolio_id,p.portfolio_name,p.chairperson,p.members]);const newT=SEED_DATA.tasks.filter(t=>!tids.has(t.task_id)).map(t=>[t.task_id,t.portfolio_id,t.phase,t.task_description,Boolean(t.completed),t.notes,t.updated_at?new Date(t.updated_at):'',Number(t.version)||1]);if(newP.length)ps.getRange(ps.getLastRow()+1,1,newP.length,4).setValues(newP);if(newT.length)ts.getRange(ts.getLastRow()+1,1,newT.length,8).setValues(newT)}
function formatDatabase_(ss){Object.entries(HEADERS).forEach(([name,h])=>{const sh=ss.getSheetByName(name),rows=Math.max(sh.getLastRow(),2);sh.setFrozenRows(1);sh.getRange(1,1,1,h.length).setBackground('#073ab7').setFontColor('#ffffff').setFontWeight('bold');if(!sh.getFilter()){try{sh.getRange(1,1,rows,h.length).createFilter()}catch(e){console.log('Filter native dikekalkan untuk '+name)}}sh.getDataRange().setVerticalAlignment('top');if(rows>1)sh.getRange(2,1,rows-1,h.length).setWrap(true)});const t=ss.getSheetByName(SHEETS.TASKS);if(t.getLastRow()>1)t.getRange(2,5,t.getLastRow()-1,1).insertCheckboxes();[150,240,180,320].forEach((w,i)=>ss.getSheetByName(SHEETS.PORTFOLIOS).setColumnWidth(i+1,w));[180,130,100,520,110,320,180,90].forEach((w,i)=>t.setColumnWidth(i+1,w));const l=ss.getSheetByName(SHEETS.LOG);[180,150,180,320,320].forEach((w,i)=>l.setColumnWidth(i+1,w));const extra=ss.getSheetByName('Sheet1');if(extra&&ss.getSheets().length>3&&extra.getLastRow()===0)ss.deleteSheet(extra)}
function doGet(e){return json_({ok:true,data:{service:'i-CSR TaskTrack 2026',status:'online'}})}
function doPost(e){try{const req=JSON.parse((e&&e.postData&&e.postData.contents)||'{}');if(req.action==='login')return json_({ok:true,data:login_(req.passphrase)});requireAuth_(req.token);let data;switch(req.action){case'readAll':data=readAll_();break;case'createTask':data=createTask_(req);break;case'updateTask':data=updateTask_(req);break;default:throw apiError_('INVALID_ACTION','Tindakan tidak sah.')}return json_({ok:true,data})}catch(err){return json_({ok:false,code:err.code||'SERVER_ERROR',error:err.message||String(err),latest:err.latest||null})}}
function login_(passphrase){const props=PropertiesService.getScriptProperties(),expected=props.getProperty('ACCESS_PASSPHRASE_HASH');if(!expected)throw apiError_('NOT_CONFIGURED','ACCESS_PASSPHRASE_HASH belum dikonfigurasi.');const actual=hex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(passphrase||''),Utilities.Charset.UTF_8));if(!timingSafe_(actual,expected.toLowerCase()))throw apiError_('AUTH_FAILED','Frasa laluan tidak sah.');const exp=Date.now()+8*60*60*1000,payload=Utilities.base64EncodeWebSafe(JSON.stringify({exp}),Utilities.Charset.UTF_8).replace(/=+$/,'');return{token:payload+'.'+sign_(payload),expires_at:new Date(exp).toISOString()}}
function requireAuth_(token){const parts=String(token||'').split('.');if(parts.length!==2||!timingSafe_(sign_(parts[0]),parts[1]))throw apiError_('AUTH_REQUIRED','Sesi tidak sah. Sila log masuk semula.');let p;try{p=JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(parts[0])).getDataAsString())}catch(e){throw apiError_('AUTH_REQUIRED','Token tidak sah.')}if(!p.exp||Date.now()>p.exp)throw apiError_('AUTH_REQUIRED','Sesi tamat. Sila log masuk semula.')}
function sign_(value){const secret=PropertiesService.getScriptProperties().getProperty('TOKEN_SECRET');if(!secret)throw apiError_('NOT_CONFIGURED','TOKEN_SECRET belum dikonfigurasi.');return hex_(Utilities.computeHmacSha256Signature(value,secret))}
function readAll_(){const ss=db_(),ps=ss.getSheetByName(SHEETS.PORTFOLIOS),ts=ss.getSheetByName(SHEETS.TASKS);return{portfolios:rows_(ps).map(r=>({portfolio_id:String(r[0]),portfolio_name:String(r[1]),chairperson:String(r[2]||''),members:String(r[3]||'')})),tasks:rows_(ts).map(taskFromRow_)}}
function createTask_(req){if(!req.portfolio_id||!['SEBELUM','SEMASA','SELEPAS'].includes(req.phase)||!String(req.task_description||'').trim())throw apiError_('VALIDATION_ERROR','Data tugasan tidak lengkap.');return locked_(()=>{const ss=db_(),sh=ss.getSheetByName(SHEETS.TASKS),id='T-'+Utilities.getUuid(),now=new Date(),row=[id,String(req.portfolio_id),req.phase,String(req.task_description).trim(),false,'',now,1];if(rows_(sh).some(r=>String(r[0])===id))throw apiError_('DUPLICATE','ID tugasan telah wujud.');sh.appendRow(row);log_(ss,'CREATE_TASK',id,'',JSON.stringify(row));return taskFromRow_(row)})}
function updateTask_(req){const allowed=['task_description','completed','notes'],changes=req.changes||{};if(!req.task_id||!Number.isFinite(Number(req.version))||!Object.keys(changes).length||Object.keys(changes).some(k=>!allowed.includes(k)))throw apiError_('VALIDATION_ERROR','Permintaan kemas kini tidak sah.');return locked_(()=>{const ss=db_(),sh=ss.getSheetByName(SHEETS.TASKS),values=sh.getDataRange().getValues(),idx=values.findIndex((r,i)=>i>0&&String(r[0])===String(req.task_id));if(idx<1)throw apiError_('NOT_FOUND','Tugasan tidak ditemui.');const old=values[idx],current=Number(old[7])||1;if(current!==Number(req.version)){const er=apiError_('VERSION_CONFLICT','Tugasan telah dikemas kini oleh pengguna lain.');er.latest=taskFromRow_(old);throw er}const next=old.slice();if('task_description'in changes){const v=String(changes.task_description||'').trim();if(!v)throw apiError_('VALIDATION_ERROR','Perihal tugasan tidak boleh kosong.');next[3]=v}if('completed'in changes)next[4]=Boolean(changes.completed);if('notes'in changes)next[5]=String(changes.notes||'').trim();next[6]=new Date();next[7]=current+1;sh.getRange(idx+1,1,1,8).setValues([next]);const action='completed'in changes?'STATUS_CHANGE':('notes'in changes?'NOTE_UPDATE':'EDIT_TASK');log_(ss,action,req.task_id,JSON.stringify(old),JSON.stringify(next));return taskFromRow_(next)})}
function rows_(sh){return sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,sh.getLastColumn()).getValues().filter(r=>String(r[0]||'').trim()):[]}function taskFromRow_(r){return{task_id:String(r[0]),portfolio_id:String(r[1]),phase:String(r[2]),task_description:String(r[3]),completed:r[4]===true||String(r[4]).toUpperCase()==='TRUE',notes:String(r[5]||''),updated_at:r[6] instanceof Date?r[6].toISOString():String(r[6]||''),version:Number(r[7])||1}}
function log_(ss,action,id,before,after){try{ss.getSheetByName(SHEETS.LOG).appendRow([new Date(),action,id,before,after])}catch(e){console.error('Log gagal: '+e)}}function db_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw apiError_('NOT_CONFIGURED','Jalankan setupICSRDatabase() dahulu.');return SpreadsheetApp.openById(id)}function locked_(fn){const lock=LockService.getScriptLock();if(!lock.tryLock(15000))throw apiError_('BUSY','Sistem sedang sibuk. Cuba lagi.');try{return fn()}finally{lock.releaseLock()}}function apiError_(code,message){const e=new Error(message);e.code=code;return e}function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON)}function hex_(bytes){return bytes.map(b=>('0'+(b<0?b+256:b).toString(16)).slice(-2)).join('')}function timingSafe_(a,b){a=String(a);b=String(b);let d=a.length^b.length;for(let i=0;i<Math.max(a.length,b.length);i++)d|=(a.charCodeAt(i)||0)^(b.charCodeAt(i)||0);return d===0}
